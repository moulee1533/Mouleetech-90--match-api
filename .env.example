# Database
# Prefer leaving unset for local Rails (uses config/database.yml per environment).
# Set only for Docker/production — a shared DATABASE_URL in .env will also hit the test env.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mouleetech_90_match_api_development

# Rails / JWT
SECRET_KEY_BASE=replace-with-rails-secret
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRY_SECONDS=86400

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# App URL used when DIGILOCKER_MOCK builds callback links
APP_PROTOCOL=http
APP_HOST=localhost
APP_PORT=3000

# DigiLocker OAuth (MeitY)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/v1/digilocker/callback
DIGILOCKER_AUTHORIZE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in
DIGILOCKER_SCOPES=openid profile
DIGILOCKER_SESSION_TTL_SECONDS=600

# Flutter deep links
APP_DEEP_LINK_SUCCESS=ninetiesmatch://digilocker/success
APP_DEEP_LINK_FAILURE=ninetiesmatch://digilocker/failure

# Local Flutter development without real DigiLocker credentials
DIGILOCKER_MOCK=true
